{
  "name": "swarm-shooter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/swarm-shooter/",
    "art:generate": "node scripts/generate-art.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "status:check": "node scripts/validate-status.mjs",
    "verify": "npm run status:check && npm run test && npm run build"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.19.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
